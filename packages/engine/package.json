{
  "name": "@mentis/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Model-first inline contenteditable engine. Not published — see docs/plan.md.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:e2e": "vite --config vite.config.ts --port 5280 --strictPort",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:chromium": "playwright test --config e2e/playwright.config.ts --project=chromium",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "happy-dom": "^18.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
